# --- Public (sent to the browser; protected by Row Level Security) ---
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Server only (NEVER add NEXT_PUBLIC_ to these) ---
# Supabase → Project Settings → API Keys → service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Free key from https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_football_data_key_here
# Comma-separated competition codes, e.g. PL,CL,PD
FOOTBALL_COMPETITIONS=PL
# Any long random string; protects /api/sync-matches
CRON_SECRET=generate_a_long_random_string
